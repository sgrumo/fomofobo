# Runtime configuration of the prod environment. No credential: those are GitHub
# environment secrets. See infra/vercel/README.md.
APP_ENV=vercel
APP_BASE_URL=PLACEHOLDER(origin of the fomofobo-prod Vercel project, TQ-23)
DATABASE_URL=PLACEHOLDER(libsql URL of the fomofobo-prod Turso database)
S3_ENDPOINT=https://74a595ea113c459ab7fce8df70206483.r2.cloudflarestorage.com
S3_BUCKET=fomofobo-prod
# Stand-ins that pass the boot check: no provider serves this environment
OIDC_ISSUER=https://issuer.invalid/prod
OIDC_CLIENT_ID=fomofobo-prod
OIDC_AUDIENCE=fomofobo-prod
