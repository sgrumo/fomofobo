# Runtime configuration of the dev environment. No credential: those are GitHub
# environment secrets. See infra/vercel/README.md.
APP_ENV=vercel
APP_BASE_URL=PLACEHOLDER(origin of the fomofobo-dev Vercel project)
DATABASE_URL=PLACEHOLDER(libsql URL of the fomofobo-dev Turso database)
S3_ENDPOINT=https://74a595ea113c459ab7fce8df70206483.r2.cloudflarestorage.com
S3_BUCKET=fomofobo-dev
# Stand-ins that pass the boot check: no provider serves this environment
OIDC_ISSUER=https://issuer.invalid/dev
OIDC_CLIENT_ID=fomofobo-dev
OIDC_AUDIENCE=fomofobo-dev
