# Each app drops a file into routes/ or sites/, so this config names no app.
# An empty or absent directory is valid.

{$DOMAIN:localhost} {
	# `handle` blocks of the main domain. Caddy orders them by matcher
	# specificity, so a catch-all still runs last whatever the file name.
	import routes/*.caddy
}

# Whole site blocks, for an app that needs an address of its own.
import sites/*.caddy
