# Catch-all of the main domain. The app serves its own pages and its own API,
# so one proxy covers both.
#
# Only one app can own "/". This file fits when no other app claims a path on DOMAIN:
# the SPA claims "/" and the standalone API claims "/api/*", which is the more
# specific matcher and would swallow the calls of this app. With either of them
# present, the app takes sites/fullstack-fomofobo.caddy instead.
handle {
	reverse_proxy fullstack-fomofobo:3000
}
