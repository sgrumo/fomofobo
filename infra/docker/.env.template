# Copy this file to .env. Then set every value marked "Required".
# Each section names the app that reads it.
# See README.md in this directory.

# --- Compose (every stack) ---

# Compose project name. It prefixes every container and volume. Leave it unset
# unless this stack replaces a deployment whose volumes it must keep, and then
# set it to that project name.
# COMPOSE_PROJECT_NAME=

# --- Caddy / TLS (every stack) ---

# Main site address. The API and the SPA answer here. With a real domain, Caddy
# gets a Let's Encrypt certificate. With "localhost", Caddy issues a
# self-signed certificate.
DOMAIN=localhost

# --- Fullstack app ---

# Site address of the fullstack app. It applies only when another app owns "/"
# on DOMAIN; with no other frontend the app answers on DOMAIN itself and this
# value goes unread. It must differ from DOMAIN, or Caddy refuses the config.
LIADRIN_DOMAIN=liadrin.localhost

# OpenID provider of the app. Required: the app signs every visitor in.
# The issuer is the URL the provider publishes its metadata under, without the
# /.well-known part. It must be reachable from the container and from a browser.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Leave it empty for a public client, which PKCE alone protects. Several providers
# mint an app client with no secret at all.
OIDC_CLIENT_SECRET=
# Audience the API accepts, as the access token carries it in `aud`.
OIDC_AUDIENCE=

# Origin the browser reads the app on, with no trailing slash. It defaults to
# https://$DOMAIN, where this app owns "/".
APP_BASE_URL=

# Register $APP_BASE_URL/auth/callback as the redirect URI of the client, and
# $APP_BASE_URL/ as the sign-out URL.

# The app reads the PostgreSQL and object storage values of the sections below.

# --- PostgreSQL ---

# Password for the postgres user. Required.
PGPASSWORD=

# --- Object storage, RustFS ---

# Object store root credentials. Required.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Caddy site address for the public S3 endpoint. It must resolve to this server
# and match the host in S3_PUBLIC_ENDPOINT below.
S3_PUBLIC_DOMAIN=s3.localhost

# Browser-reachable S3 URL. Required. It must be a full URL with a scheme,
# normally https://$S3_PUBLIC_DOMAIN (https://s3.localhost for a local trial).
S3_PUBLIC_ENDPOINT=

# Bucket name. The objectstore-init service creates it private.
S3_BUCKET=fomofobo

# Region passed to the S3 SDK.
S3_REGION=eu-west-1

# Origins of the pages that upload files, comma-separated. The browser calls the
# store directly, so the store rejects every other origin. An empty value reads as
# https://$DOMAIN. The fullstack app adds https://$LIADRIN_DOMAIN from its own
# fragment. Required when a frontend answers on any other host.
S3_CORS_ALLOW_ORIGIN=
