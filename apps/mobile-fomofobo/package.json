{
    "name": "mobile-fomofobo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "expo-router/entry",
    "scripts": {
        "start": "with-env expo start",
        "android": "with-env expo run:android",
        "build": "expo export -p android -p ios --output-dir dist",
        "clean": "rm -rf dist .expo web-build expo-env.d.ts .metro-health-check* *.tsbuildinfo",
        "clean:hard": "rm -rf ios android vendor/bundle .kotlin",
        "prebuild": "expo prebuild",
        "prebuild:clean": "expo prebuild --clean",
        "ios": "with-env expo run:ios",
        "web": "with-env expo start --web",
        "typecheck": "tsc -b",
        "lint": "oxlint --config oxlint.config.ts",
        "lint:fix": "oxlint --config oxlint.config.ts --fix",
        "test": "vitest --run",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "release:ios:distribute": "APP_ENV=dev bundle exec fastlane ios distribute --env dev",
        "release:android:distribute": "APP_ENV=dev bundle exec fastlane android distribute --env dev",
        "release:ios:store": "APP_ENV=prod bundle exec fastlane ios release --env prod",
        "release:android:store": "APP_ENV=prod bundle exec fastlane android release --env prod"
    },
    "dependencies": {
        "@expo-google-fonts/funnel-sans": "^0.4.2",
        "@expo-google-fonts/space-mono": "^0.4.2",
        "@gorhom/bottom-sheet": "^5.2.8",
        "@maplibre/maplibre-react-native": "^11.5.0",
        "@rn-primitives/slot": "^1.2.0",
        "@tanstack/react-query": "catalog:",
        "api-client": "workspace:*",
        "class-variance-authority": "^0.7.1",
        "clsx": "catalog:",
        "core-js": "~3.50.0",
        "date-fns": "catalog:",
        "domain": "workspace:*",
        "expo": "~57.0.7",
        "expo-application": "~57.0.2",
        "expo-build-properties": "~57.0.22",
        "expo-constants": "~57.0.6",
        "expo-font": "~57.0.4",
        "expo-image": "~57.0.5",
        "expo-linking": "~57.0.3",
        "expo-localization": "~57.0.2",
        "expo-location": "~57.0.21",
        "expo-router": "~57.0.7",
        "expo-splash-screen": "~57.0.4",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.3",
        "i18n": "workspace:*",
        "i18next": "catalog:",
        "lucide-react-native": "^1.0.0",
        "models": "workspace:*",
        "nativewind": "^4.2.2",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-i18n": "workspace:*",
        "react-i18next": "catalog:",
        "react-native": "0.86.3",
        "react-native-css-interop": "~0.2.2",
        "react-native-gesture-handler": "~3.1.0",
        "react-native-reanimated": "~4.5.0",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-worklets": "0.10.1",
        "shared": "workspace:*",
        "tailwind-merge": "catalog:",
        "ts-pattern": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@babel/plugin-transform-react-jsx": "^7.29.7",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "babel-preset-expo": "~57.0.3",
        "i18n-sheets": "workspace:*",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "tailwindcss": "3.4.17",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "with-env": "workspace:*"
    }
}
