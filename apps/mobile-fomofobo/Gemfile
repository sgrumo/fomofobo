source "https://rubygems.org"

ruby file: ".ruby-version"

gem "fastlane", "2.238.0"

# Outside the :ios group: the android lanes need these plugins and run with
# BUNDLE_WITHOUT=ios.
plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)

# Versions from the React Native community template, and they move with it. Its
# `xcodeproj < 1.26.0` cap holds CocoaPods at 1.15.2, because 1.16 needs 1.27.
# No concurrent-ruby cap, unlike the template: activesupport declares `logger` itself.
group :ios do
    gem "cocoapods", "1.15.2"
    gem "activesupport", "7.2.3.2"
    gem "xcodeproj", "1.25.1"
end

# Ruby 3.4 dropped these from the standard library, and CocoaPods still expects them.
gem "benchmark", "0.5.0"
gem "bigdecimal", "4.1.2"
gem "logger", "1.7.0"
gem "mutex_m", "0.3.0"
gem "nkf", "0.3.0"
