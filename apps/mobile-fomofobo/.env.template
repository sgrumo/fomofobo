# Build target: local, dev or prod. Unset is local. app.config.ts keys the application id, the
# scheme and the Firebase config off it, and checks the app values below.
#
# Do not set this by hand for a build. The `pnpm release:*` scripts pass it and the lanes
# enforce it: the distribute lanes force APP_ENV=dev; the store lanes refuse to run unless
# APP_ENV=prod was passed explicitly.

# App. A local build defaults to http://localhost:3000, where `pnpm dev:fomofobo` serves the
# API. On an Android emulator, run `adb reverse tcp:3000 tcp:3000` first, so that localhost
# reaches the host. To point a local build at another backend, put API_URL in .env.<name>
# and run `ENV_NAME=<name> pnpm start`.
# The lanes read the same files: `pnpm release:*:distribute` loads .env.dev over this file, and
# `pnpm release:*:store` loads .env.prod. Each one holds the API_URL of its environment and
# nothing else.
# dev: https://fomofobo-dev.vercel.app. prod: PLACEHOLDER(TQ-23).
API_URL=http://localhost:3000

# Firebase native config - NOT variables, and optional: the app has no Firebase SDK, and
# app.config.ts leaves the key out when the file is missing. See firebase/README.md.

# Fastlane only (not exposed to the app) - RELEASE.md says how to obtain each value. Every
# *_PATH points at a file outside the repository.

# Release version, x.y.z. Pass it on the command line of a store release:
# `APP_VERSION=1.2.0 pnpm release:ios:store`. Every store lane refuses to run without it. The
# distribute lanes ask for none: App Distribution only ever shows the value as a label.
APP_VERSION=

# Apple - App Store Connect API key (the .p8 file, App Manager role)
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=

# Apple - Team
APPLE_TEAM_ID=

# Match - certificate storage: a private git repository, SSH URL
MATCH_GIT_URL=
MATCH_PASSWORD=

# Android - keystore
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Android - Google Play
GOOGLE_PLAY_JSON_KEY_PATH=

# Firebase App Distribution - dev project only, so a production build never reaches it.
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
FIREBASE_TESTER_GROUPS=internal
FIREBASE_RELEASE_NOTES=

# iOS testers (`ios distribute`). An ipa installs only on a device its provisioning profile
# already names, so add each UDID as a `UDID<tab>Name` row under the header in
# fastlane/devices.txt, then rerun `bundle exec fastlane ios certificates` and build again.
# An existing build cannot reach a device registered after it was signed.
