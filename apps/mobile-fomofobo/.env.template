# Build target: local, dev or prod. Unset is local. app.config.ts keys the application id, the
# scheme and the Firebase config off it, and checks the app values below.
#
# Do not set this by hand for a build. The `pnpm ci:*` scripts pass it and the lanes enforce
# it: the distribute lanes force APP_ENV=dev; the release lanes refuse to run unless
# APP_ENV=prod was passed explicitly.

# App. A local build defaults to http://localhost:3000, where `pnpm dev:fomofobo` serves the
# API. On an Android emulator, run `adb reverse tcp:3000 tcp:3000` first, so that localhost
# reaches the host. To point a local build at another backend, put API_URL in .env.<name> and run `ENV_NAME=<name> pnpm start`.
# dev: https://fomofobo-dev.vercel.app. prod: PLACEHOLDER(TQ-23).
API_URL=http://localhost:3000

# Firebase native config - NOT variables. Two separate Firebase projects: a local build uses
# the dev one. Download each pair from its own project and place them here:
#   firebase/dev/{google-services.json,GoogleService-Info.plist}
#   firebase/prod/{google-services.json,GoogleService-Info.plist}
# See firebase/README.md.

# CI/Fastlane only (not exposed to the app) - see README.md for how to obtain each value

# Release version, x.y.z. The release workflows take it as a dispatch input. Every store-bound
# lane refuses to run without it. The distribute lanes ask for none: App Distribution only ever
# shows the value as a label.
APP_VERSION=

# Apple - App Store Connect API
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY=

# Apple - Team
APPLE_ID=
APPLE_TEAM_ID=
ITC_TEAM_ID=

# Match - certificate storage (S3)
MATCH_S3_BUCKET=
MATCH_S3_REGION=eu-west-1
MATCH_PASSWORD=

# Android - keystore
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Android - Google Play
GOOGLE_PLAY_JSON_KEY_PATH=

# Firebase App Distribution - dev project only, so a production build never reaches it.
# Android always uses it. iOS uses it only in a project that did not select the
# `ios-testflight` feature; a TestFlight project needs neither the iOS app id nor the
# service account, because TestFlight is the delivery there.
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
FIREBASE_TESTER_GROUPS=internal

# iOS beta, TestFlight (`ios beta`). "What to Test" text of the build, and nothing else:
# no group is named, because App Store Connect gives every build to an internal group whose
# "automatically distribute" setting is on and rejects an explicit assignment to one.
TESTFLIGHT_CHANGELOG=

# iOS beta, ad-hoc (`ios distribute`). An ipa installs only on a device its provisioning
# profile already names, so add each UDID as a `UDID<tab>Name` row under the header in
# fastlane/devices.txt, then rerun `bundle exec fastlane ios certificates` and build again.
# An existing build cannot reach a device registered after it was signed. A TestFlight
# project has no such file.
