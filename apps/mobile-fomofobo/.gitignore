# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
/vendor/bundle/

# Fastlane run artifacts
/fastlane/report.xml
/fastlane/test_output/
/fastlane/screenshots/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase native config - carries API keys, one pair per environment (firebase/README.md)
firebase/*/google-services.json
firebase/*/GoogleService-Info.plist

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
