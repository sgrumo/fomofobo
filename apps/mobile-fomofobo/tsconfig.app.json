{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "nativewind-env.d.ts"]
}
