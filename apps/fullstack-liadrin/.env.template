# Copy this file to .env.local, then set every value marked "Required".
# See infra/auth-oidc.md, and infra/vercel/README.md for a Vercel deploy.

# Deployment shape. Drives the database SSL, the error verbosity and the API
# documentation (src/server/config/app-config.ts).
APP_ENV=local

# --- PostgreSQL ---

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# --- Object storage ---

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=fomofobo
S3_REGION=eu-west-1
