# Copy this file to .env.local, then set every value marked "Required".
# Read by `next dev`. A deployment reads the variables of its Vercel project.
# See infra/auth-oidc.md and infra/vercel/README.md.

# Deployment shape. Drives the error verbosity and the API documentation
# (src/server/config/app-config.ts).
APP_ENV=local

# --- Database ---

# Local file of `pnpm db:migrate`, relative to the app directory
DATABASE_URL=file:../../.data/local.db

# --- Object storage ---

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=fomofobo
S3_REGION=eu-west-1
