{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "fomofobo",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    // Inherited by every `env` block, unlike vars and bindings.
    "minify": true,
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "fomofobo",
            "database_id": "local",
            "migrations_dir": "../../packages/storage/migrations",
        },
    ],
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "fomofobo",
        },
    ],
    "observability": {
        "enabled": true,
    },
    // Bindings and vars are not inherited: each environment repeats every one.
    "env": {
        "dev": {
            "name": "fomofobo-dev",
            "vars": {
                "APP_ENV": "cloudflare",
                "APP_BASE_URL": "https://fomofobo-dev.samuele-medici2.workers.dev",
                // Stand-ins that pass the boot check: no provider serves dev
                "OIDC_ISSUER": "https://issuer.invalid/dev",
                "OIDC_CLIENT_ID": "fomofobo-dev",
                "OIDC_AUDIENCE": "fomofobo-dev",
                "S3_ENDPOINT": "https://74a595ea113c459ab7fce8df70206483.r2.cloudflarestorage.com",
                "S3_BUCKET": "fomofobo-dev",
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "fomofobo-dev",
                    "database_id": "85269577-c0bb-49c7-9025-ecf7681b9a17",
                    "migrations_dir": "../../packages/storage/migrations",
                },
            ],
            "services": [
                {
                    "binding": "WORKER_SELF_REFERENCE",
                    "service": "fomofobo-dev",
                },
            ],
        },
        "prod": {
            "name": "fomofobo-prod",
            "vars": {
                "APP_ENV": "cloudflare",
                "APP_BASE_URL": "PLACEHOLDER(app origin of prod)",
                "OIDC_ISSUER": "PLACEHOLDER(issuer of prod)",
                "OIDC_CLIENT_ID": "PLACEHOLDER(client id of prod)",
                "OIDC_AUDIENCE": "PLACEHOLDER(audience of prod)",
                "S3_ENDPOINT": "PLACEHOLDER(https://<account id>.r2.cloudflarestorage.com)",
                "S3_BUCKET": "fomofobo-prod",
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "fomofobo-prod",
                    "database_id": "PLACEHOLDER(id of the fomofobo-prod D1 database)",
                    "migrations_dir": "../../packages/storage/migrations",
                },
            ],
            "services": [
                {
                    "binding": "WORKER_SELF_REFERENCE",
                    "service": "fomofobo-prod",
                },
            ],
        },
    },
}
