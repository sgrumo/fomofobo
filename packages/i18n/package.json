{
    "name": "i18n",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./i18n": "./src/i18n/i18n.ts",
        "./tests": "./src/tests/tests.ts",
        "./translations": "./src/translations/translations.ts"
    },
    "scripts": {
        "clean": "rm -rf *.tsbuildinfo",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -b -w",
        "lint": "oxlint --config oxlint.config.ts",
        "lint:fix": "oxlint --config oxlint.config.ts --fix",
        "test": "vitest --run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "es-toolkit": "catalog:",
        "frontend-shared": "workspace:*",
        "i18next": "catalog:",
        "shared": "workspace:*",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
