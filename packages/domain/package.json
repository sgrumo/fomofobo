{
    "name": "domain",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./local-format": "./src/local-format.ts",
        "./occurrence-progress": "./src/occurrence-progress.ts",
        "./occurrence-status": "./src/occurrence-status.ts",
        "./platform": "./src/platform.ts"
    },
    "scripts": {
