{
    "name": "storage",
    "version": "0.0.0",
    "private": true,
    "description": "",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./schema": "./src/db-schema.ts"
    },
    "scripts": {
        "clean": "rm -rf *.tsbuildinfo",
        "typecheck": "tsc -b",
        "lint": "oxlint --config oxlint.config.ts",
        "lint:fix": "oxlint --config oxlint.config.ts --fix",
        "db:gen-migration": "drizzle-kit generate --config drizzle.config.ts",
        "db:custom-migration": "drizzle-kit generate --custom --config drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
        "db:force-push": "drizzle-kit push --force --config drizzle.config.ts"
    },
    "dependencies": {
        "@hono/zod-openapi": "catalog:",
        "backend-shared": "workspace:*",
        "drizzle-orm": "catalog:",
        "models": "workspace:*",
        "pg": "catalog:",
        "shared": "workspace:*",
        "ts-pattern": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "drizzle-kit": "0.31.5",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "typescript": "catalog:"
    }
}
