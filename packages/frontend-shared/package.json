{
    "name": "frontend-shared",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./forms": "./src/forms/forms.ts",
        "./random": "./src/random/random.ts",
        "./storage": "./src/storage/storage.ts",
        "./styles": "./src/styles/styles.ts",
        "./types": "./src/types/types.ts"
    },
    "scripts": {
