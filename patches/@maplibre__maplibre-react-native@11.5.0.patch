+// A custom view takes a touch only on a React child that accepts it, so a touch on a child
+// with no pointer events, such as a tag over the pin, reaches the annotation below.
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
+  UIView *hit = [super hitTest:point withEvent:event];
+  BOOL hasCustomChildren = (self.reactSubviews.count > 0) || (self.customChildCount > 0);
+  return hit == self && hasCustomChildren ? nil : hit;
+}
