# Build context is the monorepo root; keep host build artifacts out of the image.

# Dependencies — reinstalled inside the image via pnpm --frozen-lockfile
**/node_modules

# Build outputs — rebuilt inside the image
**/dist
**/build
**/.turbo
**/.vite
**/*.tsbuildinfo

# VCS & CI
.git
.github

# Local/dev noise
.ignored
**/.env
**/.env.*
!**/.env.example
**/*.log
**/coverage
**/.nyc_output
**/playwright-report
**/test-results

# Editor / OS
.vscode
.idea
**/.DS_Store

# Docker itself
**/Dockerfile*
**/docker-compose*.yaml
**/compose*.yaml
.dockerignore
