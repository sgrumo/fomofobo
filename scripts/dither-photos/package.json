{
    "name": "dither-photos",
    "description": "CLI that replaces every stored event photo with its dithered PNG, once per environment",
    "type": "module",
    "scripts": {
        "clean": "rm -rf *.tsbuildinfo",
        "typecheck": "tsc -b",
        "lint": "oxlint --config oxlint.config.ts",
        "lint:fix": "oxlint --config oxlint.config.ts --fix",
        "dither-photos": "DISABLE_DRIZZLE_LOGS=true tsx src/index.ts"
    },
    "dependencies": {
        "@hono/zod-openapi": "catalog:",
        "backend-shared": "workspace:*",
        "models": "workspace:*",
        "shared": "workspace:*",
        "storage": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:"
    }
}
