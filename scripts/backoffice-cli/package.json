{
    "name": "backoffice-cli",
    "description": "CLI that calls the backoffice API as a signed-in account, and uploads dithered photos",
    "type": "module",
    "scripts": {
        "clean": "rm -rf *.tsbuildinfo",
        "typecheck": "tsc -b",
        "lint": "oxlint --config oxlint.config.ts",
        "lint:fix": "oxlint --config oxlint.config.ts --fix",
        "test": "vitest --run",
        "backoffice": "with-env tsx --env-file-if-exists=.env.local src/index.ts"
    },
    "dependencies": {
        "@hono/zod-openapi": "catalog:",
        "backend-shared": "workspace:*",
        "models": "workspace:*",
        "shared": "workspace:*",
        "ts-pattern": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "with-env": "workspace:*"
    }
}
